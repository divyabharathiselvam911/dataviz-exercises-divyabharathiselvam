   "source": [
    "import pandas as pd\n",
    "import plotly.express as px\n",
    "import numpy as np\n",
    "\n",
    "# Load the Airbnb London dataset\n",
    "df = pd.read_csv('../data/airbnb_london.csv')\n",
    "\n",
    "print(f\"Loaded: {len(df)} listings\")\n",
    "print(df.describe().round(1))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "87c8bfd7-7f03-48b2-a6d7-aecb32fc5d62",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "95th percentile price: £373\n",
      "                  count   mean   std   min    25%    50%    75%    max\n",
      "room_type                                                             \n",
      "Entire home/apt  1251.0  176.3  75.7  28.0  119.6  163.4  223.5  372.6\n",
      "Private room      942.0   87.3  39.5  20.9   59.0   78.6  106.0  277.9\n",
      "Shared room       182.0   46.3  14.1  20.5   36.8   44.1   54.3   92.8\n"
     ]
    }
   ],
   "source": [
    "# Cap price outliers at the 95th percentile\n",
    "p95 = df['price'].quantile(0.95)\n",
    "\n",
    "df_cap = df[df['price'] <= p95].copy()\n",
    "\n",
    "print(f\"95th percentile price: £{p95:.0f}\")\n",
    "print(df_cap.groupby('room_type')['price'].describe().round(1))"
   ]
  },
