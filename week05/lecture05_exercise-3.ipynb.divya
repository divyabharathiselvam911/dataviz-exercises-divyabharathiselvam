   "source": [
    "import os\n",
    "\n",
    "for root, dirs, files in os.walk(\"..\"):\n",
    "    dirs[:] = [d for d in dirs if d != \".venv\"]\n",
    "    for file in files:\n",
    "        if file.lower().endswith(\".csv\"):\n",
    "            print(os.path.join(root, file))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2",
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "p95 = df['price'].quantile(0.95)\n",
    "df_cap = df[df['price'] <= p95]\n",
    "print(f\"95th percentile price: £{p95:.0f}\")\n",
    "print(df_cap.groupby('room_type')['price'].describe().round(1))\n"
   ]
  },
